{
  "openapi": "3.1.0",
  "info": {
    "title": "Closerice collection reviews API",
    "version": "2.1.0",
    "description": "Authenticated Closerice meal visits and individual opinions. Requests require a signed-in browser session and X-Collection-Id. Group owners and editors may create visits and opinions; each member may change only their own opinion."
  },
  "servers": [
    {
      "url": "https://bunbun.space/closerice"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/reviews": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        }
      ],
      "get": {
        "operationId": "listReviews",
        "summary": "List meal visits with their individual opinions",
        "responses": {
          "200": {
            "description": "Review list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reviews": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Review"
                      }
                    }
                  },
                  "required": [
                    "reviews"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/reviews": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        }
      ],
      "post": {
        "operationId": "createReview",
        "summary": "Create a meal visit with the signed-in member’s opinion",
        "description": "Read receipt screenshots with the agent’s own image capability, collect the user’s comment and score, then save a new meal visit and that user’s opinion in one JSON request. For a meal visit already in the collection, use POST /api/reviews/{id}/opinions instead. Do not upload the receipt screenshot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "id",
                    "url"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/reviews/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        },
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "updateReview",
        "summary": "Edit shared meal details",
        "description": "Only the member who created this meal visit may edit its date, restaurant, food, location, and other shared details. This endpoint does not change any person’s comment or stars. To edit those, use PATCH /api/opinions/{id}.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteReview",
        "summary": "Delete a meal visit created by the signed-in member",
        "description": "Only the visit creator may delete it, and only if no other member has added an opinion. Deletion also removes its photos.",
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/reviews/{id}/opinions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        },
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "addMyOpinion",
        "summary": "Add my opinion to an existing meal visit",
        "description": "One opinion per signed-in member per visit. The author is always taken from the browser session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpinionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Opinion added"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/opinions/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        },
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "updateMyOpinion",
        "summary": "Edit my own comment and stars",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpinionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Opinion updated"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteMyOpinion",
        "summary": "Delete my own opinion",
        "responses": {
          "200": {
            "description": "Opinion deleted"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "collectionId": {
        "in": "header",
        "name": "X-Collection-Id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-closerice_session"
      }
    },
    "schemas": {
