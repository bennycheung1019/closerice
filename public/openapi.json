                  "$ref": "#/components/schemas/Opinion"
                }
              },
              "createdBy": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Google user ID of the member who created the meal visit."
              }
            },
            "required": [
              "id",
              "photos",
              "opinions"
            ]
          }
        ]
      },
