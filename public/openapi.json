{
  "openapi": "3.1.0",
  "info": {
    "title": "Closerice collection reviews API",
    "version": "2.0.0",
    "description": "Authenticated food reviews. Requests require a signed-in Closerice browser session and the X-Collection-Id header for a collection the user belongs to. Writes require owner or editor permission."
  },
  "servers": [
    {
      "url": "https://bunbun.space/closerice"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/reviews": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        }
      ],
      "get": {
        "operationId": "listReviews",
        "summary": "List the shared reviews",
        "responses": {
          "200": {
            "description": "Review list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reviews": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Review"
                      }
                    }
                  },
                  "required": [
                    "reviews"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/reviews": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        }
      ],
      "post": {
        "operationId": "createReview",
        "summary": "Save one text-only review",
        "description": "Read receipt screenshots with the agent's own image capability, collect the user's comment and score, then save the extracted data in one JSON request. Do not upload the receipt screenshot. Food photos are attached only when a person intentionally selects them in the website form.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "id",
                    "url"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/reviews/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/collectionId"
        },
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "updateReview",
        "summary": "Replace an existing review's fields",
        "description": "Only use when the user explicitly asks to edit this review. Supply all review fields as JSON.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteReview",
        "summary": "Delete a review and its images",
        "description": "Only use when the user explicitly asks to delete this review.",
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "collectionId": {
        "in": "header",
        "name": "X-Collection-Id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-closerice_session"
      }
    },
    "schemas": {
      "ReviewInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "diningDate": {
            "type": "string",
            "format": "date",
            "description": "Complete dining date, YYYY-MM-DD. Ask the user if missing."
          },
          "restaurant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "food": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "comment": {
            "type": "string",
            "maxLength": 3000,
            "default": "",
            "description": "Only the user's own opinion; never infer it from a receipt."
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5,
            "default": null
          },
          "channel": {
            "type": "string",
            "enum": [
              "keeta",
              "foodpanda",
              "takeaway",
              "dine_in"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "none",
              "favorite",
              "blacklist"
            ],
            "default": "none"
          },
          "orderNumber": {
            "type": "string",
            "maxLength": 80,
            "default": ""
          },
          "amountCents": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000000,
            "default": null,
            "description": "Amount paid in Hong Kong cents, e.g. HK$118.60 = 11860."
          },
          "district": {
            "type": "string",
            "enum": [
              "mong_kok",
              "tsim_sha_tsui",
              "central_western",
              "eastern",
              "southern",
              "wan_chai",
              "kowloon_city",
              "kwun_tong",
              "sham_shui_po",
              "wong_tai_sin",
              "yau_tsim_mong",
              "islands",
              "kwai_tsing",
              "north",
              "sai_kung",
              "sha_tin",
              "tai_po",
              "tsuen_wan",
              "tuen_mun",
              "yuen_long"
            ],
            "description": "香港18區及現有旺角、尖沙咀選項。若收據未清楚顯示分店或地址，先問用戶。"
          }
        },
        "required": [
          "diningDate",
          "restaurant",
          "food",
          "channel",
          "district"
        ]
      },
      "Review": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReviewUpdateInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "photos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "photos"
            ]
          }
        ]
      },
      "ReviewUpdateInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "diningDate": {
            "type": "string",
            "format": "date",
            "description": "Complete dining date, YYYY-MM-DD. Ask the user if missing."
          },
          "restaurant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "food": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "comment": {
            "type": "string",
            "maxLength": 3000,
            "default": "",
            "description": "Only the user's own opinion; never infer it from a receipt."
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5,
            "default": null
          },
          "channel": {
            "type": "string",
            "enum": [
              "keeta",
              "foodpanda",
              "takeaway",
              "dine_in"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "none",
              "favorite",
              "blacklist"
            ],
            "default": "none"
          },
          "orderNumber": {
            "type": "string",
            "maxLength": 80,
            "default": ""
          },
          "amountCents": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000000,
            "default": null,
            "description": "Amount paid in Hong Kong cents, e.g. HK$118.60 = 11860."
          },
          "district": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "mong_kok",
              "tsim_sha_tsui",
              "central_western",
              "eastern",
              "southern",
              "wan_chai",
              "kowloon_city",
              "kwun_tong",
              "sham_shui_po",
              "wong_tai_sin",
              "yau_tsim_mong",
              "islands",
              "kwai_tsing",
              "north",
              "sai_kung",
              "sha_tin",
              "tai_po",
              "tsuen_wan",
              "tuen_mun",
              "yuen_long",
              null
            ],
            "description": "舊紀錄可能仍未分類；編輯時可選擇地區。"
          }
        },
        "required": [
          "diningDate",
          "restaurant",
          "food",
          "channel"
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          }
        }
      }
    }
  }
}
