          "diningDate": {
            "type": "string",
            "format": "date",
            "description": "Complete dining date, YYYY-MM-DD. Ask the user if missing."
          },
          "restaurant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "food": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "comment": {
            "type": "string",
            "maxLength": 3000,
            "default": "",
            "description": "Only the user's own opinion; never infer it from a receipt."
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.5,
            "maximum": 5,
            "multipleOf": 0.5,
            "default": null
          },
          "channel": {
            "type": "string",
            "enum": [
              "keeta",
              "foodpanda",
              "takeaway",
              "dine_in"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "none",
              "favorite",
              "blacklist"
            ],
            "default": "none",
            "description": "Personal to the signed-in user in the selected collection; other members do not see this mark."
          },
          "orderNumber": {
            "type": "string",
            "maxLength": 80,
            "default": ""
          },
          "amountCents": {
            "type": [
              "integer",
              "null"
